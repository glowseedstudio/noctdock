<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local LAN stream receiving only. NoctDock does not use internet, cloud, or account services. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Held only while receiving Console Mode to keep local Wi-Fi latency low. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/ic_tv_banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.NoctDock.TV">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NoctDock.TV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
